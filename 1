:root {
    --bg: #f6f7fb;
    --surface: #ffffff;
    --text: #202532;
    --muted: #6b7280;
    --line: #dfe3ea;
    --accent: #3659d9;
    --accent-soft: #edf1ff;
    --dark: #18203a;
}

* {
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
}

body {
    margin: 0;
    font-family: Arial, sans-serif;
    color: var(--text);
    background: var(--bg);
    line-height: 1.6;
}

.container {
    width: min(1100px, calc(100% - 40px));
    margin: 0 auto;
}

.site-header {
    position: sticky;
    top: 0;
    z-index: 10;
    background: rgba(255, 255, 255, 0.96);
    border-bottom: 1px solid var(--line);
}

.header-inner,
.footer-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    min-height: 72px;
}

.brand {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    color: var(--dark);
    text-decoration: none;
    font-weight: 700;
}

.brand-mark {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 12px;
    background: var(--accent);
    color: white;
    font-size: 14px;
}

.main-nav {
    display: flex;
    gap: 20px;
    flex-wrap: wrap;
}

.main-nav a {
    color: var(--text);
    text-decoration: none;
    font-size: 14px;
}

.main-nav a:hover {
    color: var(--accent);
}

.hero {
    padding: 80px 0 64px;
    background: linear-gradient(180deg, #ffffff 0%, var(--bg) 100%);
}

.hero-grid {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: 56px;
    align-items: center;
}

.eyebrow {
    margin: 0 0 10px;
    color: var(--accent);
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
}

h1,
h2,
h3,
p {
    margin-top: 0;
}

h1 {
    margin-bottom: 22px;
    max-width: 760px;
    font-size: clamp(38px, 6vw, 66px);
    line-height: 1.05;
    letter-spacing: -0.03em;
}

h2 {
    margin-bottom: 20px;
    font-size: clamp(28px, 4vw, 42px);
    line-height: 1.15;
}

h3 {
    margin-bottom: 10px;
    font-size: 20px;
}

.hero-text,
.lead {
    max-width: 760px;
    color: var(--muted);
    font-size: 18px;
}

.button {
    display: inline-block;
    margin-top: 12px;
    padding: 12px 18px;
    border-radius: 10px;
    background: var(--accent);
    color: white;
    text-decoration: none;
    font-weight: 700;
}

.hero-card {
    padding: 22px;
    border: 1px solid var(--line);
    border-radius: 24px;
    background: var(--surface);
    box-shadow: 0 18px 50px rgba(24, 32, 58, 0.08);
}

.hero-card img {
    display: block;
    width: 100%;
    height: auto;
}

.section {
    padding: 72px 0;
}

.section-soft {
    background: var(--surface);
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
}

.cards {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    margin-top: 30px;
}

.card,
.person {
    border: 1px solid var(--line);
    border-radius: 18px;
    background: var(--surface);
}

.card {
    padding: 24px;
}

.card-number {
    display: inline-block;
    margin-bottom: 18px;
    color: var(--accent);
    font-weight: 700;
}

.card p,
.person span {
    color: var(--muted);
}

.team-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
    margin-top: 28px;
}

.person {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 22px;
}

.site-footer {
    background: var(--dark);
    color: #d7dcef;
}

.footer-inner {
    min-height: 88px;
    font-size: 14px;
}

/* В ПРАКТИЧЕСКОЙ №9 студент B должен добавить оформление для нового блока #contacts.
   Не вставляйте готовое решение сюда до начала работы. */

@media (max-width: 760px) {
    .header-inner,
    .footer-inner,
    .main-nav {
        align-items: flex-start;
        flex-direction: column;
    }

    .header-inner {
        padding: 16px 0;
    }

    .hero-grid,
    .cards,
    .team-grid {
        grid-template-columns: 1fr;
    }

    .hero {
        padding-top: 54px;
    }
}
